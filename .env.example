# Hermes Kanban Dashboard — environment variables
# Copy to .env (or export inline) and adjust as needed. All values are optional.

# Path to the `hermes` CLI binary.
# Default: $HOME/.hermes/hermes-agent/.hermes/bin/hermes
# HERMES_BIN=/opt/hermes/bin/hermes

# Hermes data root (contains kanban DBs, logs/, kanban/logs/, ...).
# Default: $HOME/.hermes
# HERMES_HOME=/var/lib/hermes

# Bind host/port for the dashboard HTTP server.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8788

# If set, every /api/* request requires `Authorization: Bearer <token>`
# or `?token=<token>`. Leave unset for a trusted LAN / loopback deployment.
# DASHBOARD_TOKEN=change-me-please

# SSE poll interval in seconds (float).
DASHBOARD_POLL=2.0
